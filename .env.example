# Local NexusPlanner backend defaults.
# Supabase CLI generates runtime keys on `supabase start`; copy the values from `supabase status`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI reads NEXUS_* first. Keep these aligned with Supabase status.
NEXUS_API_URL=http://127.0.0.1:54321
NEXUS_PUBLISHABLE_KEY=
NEXUS_ACCESS_TOKEN=
NEXUS_ORGANIZATION_ID=
NEXUS_PROJECT_ID=

# Required only when invoking supabase/functions/job-worker directly.
JOB_WORKER_SECRET=change-me-local-only
